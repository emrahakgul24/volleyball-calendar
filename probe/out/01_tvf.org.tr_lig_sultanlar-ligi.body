        <script>
            document.addEventListener('DOMContentLoaded', function () {
                initBandSwiper('tvf-news', { 576: 2, 992: 3 });
            });
        </script>
        <script>
        // Sponsor akordeonu — sadece ≤768px'te. Sayfada birden fazla sponsor bloğu
        // olabilir (takım detayı 3 tane basıyor), o yüzden hepsi tek tek bağlanıyor.
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.tvf-sponsors').forEach(function(block) {
                const trigger = block.querySelector('.accordion-trigger');
                const content = block.querySelector('.accordion-content');
                if (!trigger || !content) return;

                trigger.addEventListener('click', function() {
                    if (window.innerWidth > 768) return;
                    trigger.classList.toggle('active');
                    content.classList.toggle('active');
                });
            });
        });
    </script>
         <script type="text/javascript">
             var swiperAds = new Swiper("#adsSwiper", {
                 /* Son Haberler bandıyla aynı davranış (assets/js/band-swiper.js). */
                 slidesPerView: 1,
                 spaceBetween: 16,
                 slidesOffsetAfter: 15,
                 loop: true,
                 /* ⚠ Buraya İKİNCİ bir `autoplay` EKLEME. Önce nesne, hemen ardından
                    `autoplay: true` yazılmıştı; sonraki anahtar öncekini ezdiği için
                    `pauseOnMouseEnter` hiç uygulanmıyordu. */
                 autoplay: {
                     delay: 3000,
                     disableOnInteraction: false,
                     pauseOnMouseEnter: true,
                 },
                 navigation: {
                     nextEl: ".tvf-ads__next",
                     prevEl: ".tvf-ads__prev",
                 },
                 breakpoints: {
                     // 8 değil 7: kap `container-fluid`e geçince (bkz. 7y) şerit daraldı ve
                     // 8 kart görselleri küçültüyordu. 7 kart, eski genişlikteki ölçüyü
                     // geri veriyor (1440'ta 145px → 168px, eski hâli 163px).
                     1400: {
                         slidesPerView: 7,
                         spaceBetween: 20,
                     },
                     1024: {
                         slidesPerView: 4,
                         spaceBetween: 20,
                     },
                     768: {
                         slidesPerView: 3,
                         spaceBetween: 20,
                     },
                     /* 640 değil 576: Son Haberler bandının ilk kırılımı da 576, iki şerit
                        aynı noktada 2 karta geçsin diye. */
                     576: {
                         slidesPerView: 2,
                         spaceBetween: 20,
                     },
                 }
             });
         </script>
