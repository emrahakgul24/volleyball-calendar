        <style>
        .goldenset img {
            width: 16px;
            height: 16px;
            margin-right: 5px;

        }

        .goldenset {
            color: #ecaa26;
        }

        .calendar .content .content-area .fixture .item .teams .team span.goldenset b {
            color: #ecaa26 !important;
        }



        /* ⚠ GERİ EKLEME: burada `.btn.btn-outline-sponsor-active` ve
           `.btn.btn-outline-sponsor:hover` kuralları vardı; ikon boşluğunu ve play
           üçgeninin rengini bozuyorlardı. İkisi de artık `components/_buttons.scss`te,
           tek sınıfın durumları olarak. Buraya tekrar yazılırsa `.btn.` ön ekiyle
           özgüllüğü yüksek olduğu için oradaki kuralları ezer. */

        /* Blurred effect with transition */
        .cRow {
            position: relative;
            /* Ensure positioning context for overlay */
            transition: filter 1s ease;
            /* Smooth transition for blur effect */
        }

        section.content .table tbody tr td:nth-child(4),
        section.content .table tbody tr td:nth-child(6) {
            font-weight: inherit !important;
        }

        .cellred {
            background-color: #ffd8d8 !important;
            font-weight: bold !important;
        }

        .cRow .onLoading {
            filter: blur(7px);
            pointer-events: none;
        }

        /* Loading Overlay (Positioned behind the blurred content) */
        .loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.7);
            z-index: -1;
            /* Set to -1 to place behind the blurred content */
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
            /* Prevent interaction with the overlay */
        }

        .onLoading .loading-overlay {
            opacity: 1;
        }

        /* Loading Spinner */
        .loading-spinner {
            border: 4px solid rgba(0, 0, 0, 0.1);
            border-left-color: #000;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        section.content .sidebar .nav ul li.active a span {
            color: var(--sponsor-main) !important;
        }

        section.content .table tbody tr td:first-child {
            text-align: inherit;
            color: inherit !important;
        }

        section.content .table thead tr th:nth-child(2) {
            width: inherit !important;
            text-align: center !important;
        }

        /* 2026-10-01: puan durumunda takım adları sola yaslı, başlıkları ortadaydı.
           Yalnız puan tablosu; fikstür tablosundaki ikinci sütun ortalı kalıyor. */
        section.content .table.tvf-standings thead tr th:nth-child(2) {
            text-align: start !important;
        }

        .fixtureTable .table thead tr th:nth-child(2) {
            width: 55px !important;
        }

        .fixtureTable .table thead tr th:nth-child(3) {
            width: 55px !important;
        }

        .fixtureTable .table thead tr th:nth-child(4) {
            width: 55px !important;
        }
    </style>
     
          <link href="/assets/scss/league.min.css?v=1.55" rel="stylesheet">
     <style>
         /* Sponsor Colors
            ⚠ `:root` DEĞİL `body`: bu blok layout'ta home.min.css'ten ÖNCE basılıyor
            (styles yığını), yani `:root`a yazılan bir token `themes/_theme.scss`'teki
            `:root` tarafından eziliyordu. Eskiden yalnızca `--sponsor-main` ve
            `--gradient` `!important` taşıdığı için ayakta kalıyor, `--sponsor-main-dark`
            ile `--sponsor-text` sessizce global değere düşüyordu: ligin rengi ne olursa
            olsun hover `#C90026` (kurumsal kırmızı) çıkıyordu — Efeler'de lacivert buton
            kırmızıya dönüyordu. `body` daha derin bir eleman olduğu için dördü de
            kaynak sırasından bağımsız kazanıyor, `!important` gerekmiyor.
            ⚠⚠ Bu yorumun içine Blade direktifi ADI yazma: Blade direktifleri CSS
            yorumunun içinde de çalışıyor, blok bozuluyor. */
         body {
             --sponsor-main: #e61919;
             --sponsor-main-dark: #e01414;
             --sponsor-main-gradient: transparent linear-gradient(180deg, #e61919 0%, #e01414 100%) 0% 0% no-repeat padding-box;
             --sponsor-text: #ffffff;
         }
     </style>
