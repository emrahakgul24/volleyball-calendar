    <script src="/assets/js/tr.global.js"></script>
    <script>
        if (window.innerWidth < 900) {
            var element = document.getElementById('filters');
            if (element) {
                element.click();
            }
        }
        startCalendar();


        function startCalendar(selectedDate = null, events = null) {

            /* Calendar */
            function updateButtonLabels(calendar) {
                const currentMonth = calendar.getDate();
                const currentMonthName = currentMonth.toLocaleString('default', {
                    month: 'long'
                });

                const prevMonth = new Date(currentMonth);
                prevMonth.setMonth(currentMonth.getMonth() - 1);
                const prevMonthName = prevMonth.toLocaleString('default', {
                    month: 'long'
                });

                const nextMonth = new Date(currentMonth);
                nextMonth.setMonth(currentMonth.getMonth() + 1);
                const nextMonthName = nextMonth.toLocaleString('default', {
                    month: 'long'
                });

                document.querySelector('.fc-prev-button').textContent = `${prevMonthName}`;
                document.querySelector('.fc-next-button').textContent = `${nextMonthName}`;
            }

            var calendarEl = document.getElementById('calendar');
            let calendarEvents = events ? events : JSON.parse('[{\u0022title\u0022:1,\u0022start\u0022:\u00222026-08-04\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-08-05\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-08-07\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-08-08\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-08-11\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-08-12\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-08-13\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-08-15\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-08-16\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-08-17\u0022},{\u0022title\u0022:10,\u0022start\u0022:\u00222026-08-19\u0022},{\u0022title\u0022:10,\u0022start\u0022:\u00222026-08-20\u0022},{\u0022title\u0022:10,\u0022start\u0022:\u00222026-08-21\u0022},{\u0022title\u0022:16,\u0022start\u0022:\u00222026-08-22\u0022},{\u0022title\u0022:15,\u0022start\u0022:\u00222026-08-23\u0022},{\u0022title\u0022:5,\u0022start\u0022:\u00222026-08-24\u0022},{\u0022title\u0022:5,\u0022start\u0022:\u00222026-08-25\u0022},{\u0022title\u0022:4,\u0022start\u0022:\u00222026-08-26\u0022},{\u0022title\u0022:5,\u0022start\u0022:\u00222026-08-27\u0022},{\u0022title\u0022:4,\u0022start\u0022:\u00222026-08-28\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-08-29\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-08-30\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-08-31\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-09-01\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-09-02\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-09-03\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-09-05\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-09-06\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-09-10\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-09-12\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-09-13\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-09-14\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-09-16\u0022},{\u0022title\u0022:16,\u0022start\u0022:\u00222026-09-26\u0022},{\u0022title\u0022:28,\u0022start\u0022:\u00222026-09-27\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-09-28\u0022},{\u0022title\u0022:15,\u0022start\u0022:\u00222026-09-29\u0022},{\u0022title\u0022:29,\u0022start\u0022:\u00222026-09-30\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-10-02\u0022},{\u0022title\u0022:41,\u0022start\u0022:\u00222026-10-03\u0022},{\u0022title\u0022:84,\u0022start\u0022:\u00222026-10-04\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-10-05\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-10-06\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-10-08\u0022},{\u0022title\u0022:5,\u0022start\u0022:\u00222026-10-09\u0022},{\u0022title\u0022:52,\u0022start\u0022:\u00222026-10-10\u0022},{\u0022title\u0022:77,\u0022start\u0022:\u00222026-10-11\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-10-12\u0022},{\u0022title\u0022:7,\u0022start\u0022:\u00222026-10-14\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-10-16\u0022},{\u0022title\u0022:45,\u0022start\u0022:\u00222026-10-17\u0022},{\u0022title\u0022:87,\u0022start\u0022:\u00222026-10-18\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-10-19\u0022},{\u0022title\u0022:13,\u0022start\u0022:\u00222026-10-20\u0022},{\u0022title\u0022:40,\u0022start\u0022:\u00222026-10-23\u0022},{\u0022title\u0022:95,\u0022start\u0022:\u00222026-10-24\u0022},{\u0022title\u0022:92,\u0022start\u0022:\u00222026-10-25\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-10-26\u0022},{\u0022title\u0022:8,\u0022start\u0022:\u00222026-10-27\u0022},{\u0022title\u0022:6,\u0022start\u0022:\u00222026-10-28\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-10-30\u0022},{\u0022title\u0022:49,\u0022start\u0022:\u00222026-10-31\u0022},{\u0022title\u0022:81,\u0022start\u0022:\u00222026-11-01\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-11-02\u0022},{\u0022title\u0022:13,\u0022start\u0022:\u00222026-11-03\u0022},{\u0022title\u0022:35,\u0022start\u0022:\u00222026-11-04\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-11-05\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-11-06\u0022},{\u0022title\u0022:55,\u0022start\u0022:\u00222026-11-07\u0022},{\u0022title\u0022:77,\u0022start\u0022:\u00222026-11-08\u0022},{\u0022title\u0022:13,\u0022start\u0022:\u00222026-11-10\u0022},{\u0022title\u0022:31,\u0022start\u0022:\u00222026-11-11\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-11-12\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-11-13\u0022},{\u0022title\u0022:50,\u0022start\u0022:\u00222026-11-14\u0022},{\u0022title\u0022:78,\u0022start\u0022:\u00222026-11-15\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-11-16\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-11-17\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-11-18\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-11-19\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-11-20\u0022},{\u0022title\u0022:55,\u0022start\u0022:\u00222026-11-21\u0022},{\u0022title\u0022:75,\u0022start\u0022:\u00222026-11-22\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-11-23\u0022},{\u0022title\u0022:5,\u0022start\u0022:\u00222026-11-24\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-11-25\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-11-27\u0022},{\u0022title\u0022:46,\u0022start\u0022:\u00222026-11-28\u0022},{\u0022title\u0022:81,\u0022start\u0022:\u00222026-11-29\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-11-30\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-12-04\u0022},{\u0022title\u0022:51,\u0022start\u0022:\u00222026-12-05\u0022},{\u0022title\u0022:70,\u0022start\u0022:\u00222026-12-06\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-12-07\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-12-11\u0022},{\u0022title\u0022:19,\u0022start\u0022:\u00222026-12-12\u0022},{\u0022title\u0022:8,\u0022start\u0022:\u00222026-12-13\u0022},{\u0022title\u0022:2,\u0022start\u0022:\u00222026-12-14\u0022},{\u0022title\u0022:3,\u0022start\u0022:\u00222026-12-18\u0022},{\u0022title\u0022:46,\u0022start\u0022:\u00222026-12-19\u0022},{\u0022title\u0022:75,\u0022start\u0022:\u00222026-12-20\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-12-21\u0022},{\u0022title\u0022:7,\u0022start\u0022:\u00222026-12-22\u0022},{\u0022title\u0022:7,\u0022start\u0022:\u00222026-12-23\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-12-25\u0022},{\u0022title\u0022:41,\u0022start\u0022:\u00222026-12-26\u0022},{\u0022title\u0022:62,\u0022start\u0022:\u00222026-12-27\u0022},{\u0022title\u0022:1,\u0022start\u0022:\u00222026-12-28\u0022}]');
            const eventDates = calendarEvents.map(event => new Date(event.start).toISOString().split('T')[0]); // YYYY-MM-DD formatı
            var calendar = new FullCalendar.Calendar(calendarEl, {
                headerToolbar: {
                    left: 'prev',
                    center: 'title',
                    right: 'next'
                },
                datesSet: function(info) {
                    updateButtonLabels(calendar);
                    // console.log('Ay değişti:', info.view);
                    // const startDate = info.view.currentStart.toISOString(); // Başlangıç tarihi
                    // const endDate = info.view.currentEnd.toISOString(); // Bitiş tarihi
                    // console.log(startDate, endDate);
                },
                dayCellDidMount: function(info) {
                    const dateStr = info.date.toISOString().split('T')[0];
                    const hasEvent = calendar.getEvents().some(event => {
                        const eventDate = event.start.toISOString().split('T')[0];
                        return eventDate === dateStr;
                    });

                    if (!hasEvent) {
                        info.el.classList.add('disabled-date');
                        info.el.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                        });
                    }
                },

                locale: "tr",
                navLinks: false,
                businessHours: false,
                editable: false,
                selectable: false,
                droppable: false,
                // ⚠ ≤1023'te hücreler 56px'e büyüyor (`pages/_calendar.scss`, dokunmatik
                // düzen) — sabit 307px'te 5. ve 6. haftalar `.fc-scroller { overflow: hidden }`
                // altında kesiliyordu. Kırılım SCSS'teki ile aynı.
                height: window.innerWidth <= 1023 ? 'auto' : 307,
                dateClick: function(info) {
                    if (info.dayEl.classList.contains('disabled-date')) {
                        return false;
                    }
                    document.querySelector('.calendar .content').classList.add('onLoading');
                    Livewire.dispatch('setDate', {
                        dateValue: info.dateStr
                    });
                },
                eventClick: function(info) {
                    if (info.el.classList.contains('disabled-date')) {
                        return false;
                    }
                    const date = new Date(info.event.start);
                    const day = String(date.getDate()).padStart(2, '0');
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const year = date.getFullYear();
                    const formattedDate = `${year}-${month}-${day}`;
                    document.querySelector('.calendar .content').classList.add('onLoading');
                    Livewire.dispatch('setDate', {
                        dateValue: formattedDate
                    });
                },
                events: calendarEvents,
            });
            calendar.render();
            if (selectedDate) {
                calendar.gotoDate(new Date(selectedDate));
                calendar.select(selectedDate ? new Date(selectedDate) : new Date());
            }

            // ⚠ Fikstür/Puan Durumu geçişi yalnız istemcide. Livewire her yeniden çizimde
            // `#board`a `display:none` basıyordu; Puan Durumu açıkken etap seçince görünüm
            // Fikstür'e dönüyordu. Seçim `window.calendarInnerTab`ta tutulup her çizimde
            // yeniden uygulanıyor. `onclick` (addEventListener değil): startCalendar her
            // dataChanged'de yeniden çalışıyor, dinleyiciler birikmesin.
            const getBoard = document.getElementById("getBoard");
            const getFixture = document.getElementById("getFixture");
            if (getBoard && getFixture) {
                const applyInnerTab = (tab) => {
                    window.calendarInnerTab = tab;
                    const isBoard = tab === "board";
                    getBoard.classList.toggle("active", isBoard);
                    getFixture.classList.toggle("active", !isBoard);
                    document.getElementById("fixture").style.display = isBoard ? "none" : "block";
                    document.getElementById("board").style.display = isBoard ? "block" : "none";
                    document.getElementById("calendarDay")?.classList.toggle("d-none", isBoard);
                };
                getBoard.onclick = () => applyInnerTab("board");
                getFixture.onclick = () => applyInnerTab("fixture");
                applyInnerTab(window.calendarInnerTab ?? "fixture");
            } else {
                window.calendarInnerTab = "fixture";
            }


        }
        document.addEventListener('livewire:init', () => {
            Livewire.on('dataChanged', (event) => {
                setTimeout(() => {
                    startCalendar(event[0]?.selectedDate ?? null, event[0]?.events ?? null);
                    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
                    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
                }, 10);

            });
        });
    </script>
        
        <script src="/assets/js/band-swiper.js?v=2"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                initBandSwiper('tvf-news', { 576: 2, 992: 3 });
            });
        </script>
             <script type="text/javascript">
             var swiperAds = new Swiper("#adsSwiper", {
                 /* Son Haberler bandıyla aynı davranış (assets/js/band-swiper.js). */
                 slidesPerView: 1,
                 spaceBetween: 16,
                 slidesOffsetAfter: 15,
                 loop: true,
                 /* ⚠ Buraya İKİNCİ bir `autoplay` EKLEME. Önce nesne, hemen ardından
                    `autoplay: true` yazılmıştı; sonraki anahtar öncekini ezdiği için
                    `pauseOnMouseEnter` hiç uygulanmıyordu. */
                 autoplay: {
                     delay: 3000,
                     disableOnInteraction: false,
                     pauseOnMouseEnter: true,
                 },
                 navigation: {
                     nextEl: ".tvf-ads__next",
                     prevEl: ".tvf-ads__prev",
                 },
                 breakpoints: {
                     // 8 değil 7: kap `container-fluid`e geçince (bkz. 7y) şerit daraldı ve
                     // 8 kart görselleri küçültüyordu. 7 kart, eski genişlikteki ölçüyü
                     // geri veriyor (1440'ta 145px → 168px, eski hâli 163px).
                     1400: {
                         slidesPerView: 7,
                         spaceBetween: 20,
                     },
                     1024: {
                         slidesPerView: 4,
                         spaceBetween: 20,
                     },
                     768: {
                         slidesPerView: 3,
                         spaceBetween: 20,
                     },
                     /* 640 değil 576: Son Haberler bandının ilk kırılımı da 576, iki şerit
                        aynı noktada 2 karta geçsin diye. */
                     576: {
                         slidesPerView: 2,
                         spaceBetween: 20,
                     },
                 }
             });
         </script>
