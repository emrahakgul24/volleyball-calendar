        <link href="/assets/scss/calendar.min.css?v=1.67" rel="stylesheet">

    <style>
        .goldenset {
            color: #ecaa26;
        }

        .calendar .content .content-area .fixture .item .teams .team span.goldenset b {
            color: #ecaa26 !important;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .goldenset ::before {
            content: url(/assets/images/gold-icon.svg);
            width: 8px;
            height: 8px;
            margin-right: 5px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .calendar .content .content-area .fixture .item .score {
            justify-content: center !important;
            flex-direction: column;
            align-items: flex-start;
        }

        .fc-daygrid-day-events {
            cursor: pointer !important;
        }

        .disabled-date {
            pointer-events: none !important;
            cursor: not-allowed !important;
        }

        .fc-daygrid-day-top {
            cursor: pointer;
        }

        .calendar-loader {
            height: 310px !important;
            transition: opacity 0.8s ease;
            opacity: 0;
            position: absolute;
            width: 90%;
            display: flex;
            justify-content: center;
            align-content: center;
            align-items: center;
        }

        .lds-ellipsis,
        .lds-ellipsis div {
            box-sizing: border-box;
        }

        .lds-ellipsis {
            display: inline-block;
            position: relative;
            width: 80px;
            height: 80px;
        }

        .lds-ellipsis div {
            position: absolute;
            top: 33.33333px;
            width: 13.33333px;
            height: 13.33333px;
            border-radius: 50%;
            background: currentColor;
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

        .lds-ellipsis div:nth-child(1) {
            left: 8px;
            animation: lds-ellipsis1 0.6s infinite;
        }

        .lds-ellipsis div:nth-child(2) {
            left: 8px;
            animation: lds-ellipsis2 0.6s infinite;
        }

        .lds-ellipsis div:nth-child(3) {
            left: 32px;
            animation: lds-ellipsis2 0.6s infinite;
        }

        .lds-ellipsis div:nth-child(4) {
            left: 56px;
            animation: lds-ellipsis3 0.6s infinite;
        }

        @keyframes lds-ellipsis1 {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @keyframes lds-ellipsis3 {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }

        @keyframes lds-ellipsis2 {
            0% {
                transform: translate(0, 0);
            }

            100% {
                transform: translate(24px, 0);
            }
        }



        #calendar {
            min-height: 310px;
            transition: opacity 0.8s ease;
            position: relative;
            /* Konumlandırma yapılacak */
        }

        /* Loading state for the calendar */
        .onLoading #calendar {
            opacity: 0;
            pointer-events: none;
        }

        .onLoading .calendar-loader {
            opacity: 1;
            pointer-events: none;
        }

        .content-area {
            transition: opacity 0.5s ease;
        }

        /* Content loading state */
        .onLoading .content-area {
            opacity: 0.5;
            pointer-events: none;
        }

        .onLoading #filterlist {
            opacity: 0.5;
            pointer-events: none;
        }

        @media only screen and (max-width: 900px) {
            .calendar .content .content-area .fixture {
                min-width: 100% !important;
            }

            .calendar .content .content-area .fixture .item {
                display: flex;
                align-items: stretch;
                padding: 0px 0px;
                justify-content: space-between;
                min-height: 50px;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                width: 100%;
                max-width: 100%;
                padding: 4px;
                border: 1px solid #0000000f;
            }

            .calendar .content .content-area .fixture .item .hour {
                width: 13%;
                font-weight: bold;
                border-radius: 8px;
            }

            /* ⚠ `.teams` ızgara düzeni ve takım adı kutusu artık
               `pages/_calendar.scss` sonundaki blokta.
               Buradaki `width: 89%` / `min-width: 60px` kuralları adları
               kırpıyordu, kaldırıldı. */



            .calendar .content .content-area .fixture .item .score {
                width: 100%;
                justify-content: center !important;
                display: flex;
                align-items: center;
            }



            .calendar .content .content-area .fixture .item .teams {

                margin-bottom: 5px;
                margin-top: 5px;
            }

            .calendar .content .content-area .fixture .item .actions {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding-right: 0px;
            }

            .calendar-area {
                order: 1;
            }

            .calendar-area .details .title:nth-child(1) {
                display: none !important;
            }

            .calendar .content .calendar-area {
                width: 100%;
                min-height: auto;
                height: auto;
            }

            .fixture-schedule-download {
                flex-direction: row !important;
            }

            .calendar .content .calendar-area .fixture-schedule-download .img img {
                max-width: 85px;
            }

            .calendar .content .calendar-area .fixture-schedule-download .items .content span {
                font-size: 18px;
            }
        }
    </style>
