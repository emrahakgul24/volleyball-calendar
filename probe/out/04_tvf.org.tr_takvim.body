    <section class="calendar">
        <div class="px-0 container-fluid">
            <div class="row">
                
                <div class="heading heading--page-top">
                    <h1 class="title h2">Takvim</h1>
                    <p class="desc">Sıradaki tüm maçları buradan takip edebilirsin.</p>
                </div>

                <div class="content" wire:loading.class="onLoading" wire:target="currentLeague, setDate,  setFilter, selectedCountry, selectedProvince, selectedGender, clearFilter">

                    <div class="calendar-area">
                        <div class="details">
                            <!-- Takvim -->
                            <span class="title">Takvim</span>
                            <div class="calendar-loader">
                                <div class="lds-ellipsis">
                                    <div></div>
                                    <div></div>
                                    <div></div>
                                    <div></div>
                                </div>
                            </div>
                            <div id='calendar'></div>

                            <!-- //Takvim -->
                            <a class="title" id="filters" data-bs-toggle="collapse" href="#filterlist" role="button" aria-expanded="true" aria-controls="filterlist">Filtreler</a>
                            <hr />
                            <div class="collapse show" id="filterlist">
                                <div class="filter-item radios">
                                    <span class="filter-title">Cinsiyet:</span>
                                    <div class="right">
                                        <div class="form-check">
                                            <input wire:loading.attr="disabled" class="form-check-input" type="radio" value="K" wire:model.change="selectedGender" id="woman">
                                            <label class="form-check-label" for="woman">Kadın</label>
                                        </div>
                                        <div class="form-check">
                                            <input wire:loading.attr="disabled" class="form-check-input" type="radio" value="E" wire:model.change="selectedGender" id="man">
                                            <label class="form-check-label" for="man">Erkek</label>
                                        </div>
                                        <div class="form-check">
                                            <input wire:loading.attr="disabled" class="form-check-input" type="radio" value="-" wire:model.change="selectedGender" id="all">
                                            <label class="form-check-label" for="all">Tümü</label>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="filter-item checks">
                                    <span class="filter-title">Tüm Ligler:</span>
                                    <div class="right">
                                        <div class="form-check">
                                            <input wire:loading.attr="disabled" class="form-check-input" type="checkbox" value="I" wire:model.change="selectedCountry">
                                            <label class="form-check-label" for="europe">Avrupa Kupaları ve Milli Maçlar</label>
                                        </div>
                                        <div class="form-check">
                                            <input wire:loading.attr="disabled" class="form-check-input" type="checkbox" value="N" wire:model.change="selectedCountry">
                                            <label class="form-check-label" for="turkiye">Türkiye Ligleri</label>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="form-floating col-12">
                                    <select wire:loading.attr="disabled" wire:model.change="currentLeague" class="form-control form-select">
                                        <option value="-">Tümü</option>
